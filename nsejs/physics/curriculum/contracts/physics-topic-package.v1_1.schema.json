      "type": "object",
      "additionalProperties": false,
      "required": [
        "save_first_answer_before_hint",
        "track_help_exposure",
        "preserve_original_revision",
        "fail_closed_on_storage_error"
      ],
      "properties": {
        "save_first_answer_before_hint": {
          "const": true
        },
        "track_help_exposure": {
          "const": true
        },
        "preserve_original_revision": {
          "const": true
        },
        "fail_closed_on_storage_error": {
          "const": true
        }
