      "properties": {
        "b1_b7": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "B1",
            "B2",
            "B3",
            "B4",
            "B5",
            "B6",
            "B7"
          ],
          "properties": {
            "B1": {
              "$ref": "#/$defs/witness"
            },
            "B2": {
              "$ref": "#/$defs/witness"
            },
            "B3": {
              "$ref": "#/$defs/witness"
            },
            "B4": {
              "$ref": "#/$defs/witness"
            },
            "B5": {
              "$ref": "#/$defs/witness"
            },
            "B6": {
              "$ref": "#/$defs/witness"
            },
            "B7": {
              "$ref": "#/$defs/witness"
            }
          }
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_authenticity",
            "content_correctness",
            "cognitive_qualification",
            "teaching_sufficiency",
            "assessment_validity",
            "implementation",
            "release_authority"
