        "version": {
          "type": "string",
          "minLength": 1
        },
        "for_blueprint": {
          "const": "PHYS-QRT-BLUEPRINT 0.2.0"
        },
        "status": {
          "type": "string",
          "enum": [
            "DRAFT_OWNER_REVIEW",
            "CANDIDATE_ONLY"
          ]
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cell_id",
              "instance_ids"
