      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "git_blob_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "evidence"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "qrt_target": {
      "type": "object",
      "additionalProperties": false,
