          "properties": {
            "source_authenticity": {
              "type": "string",
              "enum": [
                "HOLD",
                "NOT_RUN"
              ]
            },
            "content_correctness": {
              "type": "string",
              "enum": [
                "HOLD",
                "NOT_RUN"
              ]
            },
            "cognitive_qualification": {
              "type": "string",
              "enum": [
                "HOLD",
                "NOT_RUN"
              ]
            },
            "teaching_sufficiency": {
              "type": "string",
              "enum": [
                "HOLD",
                "NOT_RUN"
              ]
            },
            "assessment_validity": {
              "type": "string",
              "enum": [
                "HOLD",
                "NOT_RUN"
              ]
            },
            "implementation": {
              "type": "string",
              "enum": [
                "HOLD",
                "NOT_RUN"
              ]
            },
            "release_authority": {
              "type": "string",
              "enum": [
                "HOLD",
                "NOT_RUN"
              ]
            }
          }
        },
        "release": {
          "const": "HOLD"
        },
        "acceptance_note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
