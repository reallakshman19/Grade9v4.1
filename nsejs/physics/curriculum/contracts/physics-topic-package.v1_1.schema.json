        "conditions_and_limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "units_and_signs": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "qualification_status": {
          "type": "string",
          "enum": [
            "HOLD",
            "CANDIDATE_REVIEW"
          ]
        }
      }
