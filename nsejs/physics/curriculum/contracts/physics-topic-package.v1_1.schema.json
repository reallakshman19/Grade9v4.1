      "required": [
        "id",
        "kind",
        "subtopic_id",
        "qrt_target_id",
        "fresh_task",
        "protected_work",
        "differs_from_worked_anchor",
        "stages",
        "attempt_policy",
        "runtime_verification",
        "cell_id",
        "instance_qrt_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "MAIN",
            "INSTANCE"
          ]
        },
        "subtopic_id": {
          "type": "string",
          "minLength": 1
        },
        "qrt_target_id": {
          "type": "string",
          "minLength": 1
        },
        "fresh_task": {
          "type": "string",
          "minLength": 1
        },
        "protected_work": {
          "type": "string",
          "minLength": 1
        },
