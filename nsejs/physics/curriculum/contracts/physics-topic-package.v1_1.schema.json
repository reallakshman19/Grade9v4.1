      "required": [
        "predict",
        "attempt",
        "reconstruct",
        "diagnose",
        "repair",
        "boundary_test"
      ],
      "properties": {
        "predict": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "string",
          "minLength": 1
        },
        "reconstruct": {
          "type": "string",
          "minLength": 1
        },
        "diagnose": {
          "type": "string",
          "minLength": 1
        },
        "repair": {
          "type": "string",
          "minLength": 1
        },
        "boundary_test": {
          "type": "string",
          "minLength": 1
        }
      }
    },
