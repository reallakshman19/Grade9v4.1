  "additionalProperties": false,
  "required": [
    "schema",
    "subject_id",
    "academic_track",
    "topic_id",
    "owner_agent",
    "version",
    "status",
    "pins",
    "syllabus_references",
    "subtopics",
    "science_records",
    "topic_adapter",
    "core1a",
    "core1b",
    "core2_sources",
    "acceptance"
