          "minItems": 1
        }
      }
    },
    "core1a": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/core1a"
      },
      "minItems": 1
    },
    "core1b": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/core1b"
      },
      "minItems": 1
    },
    "core2_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 0
