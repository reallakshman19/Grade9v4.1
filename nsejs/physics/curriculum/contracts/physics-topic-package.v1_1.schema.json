    "status": {
      "const": "DRAFT_AUTHOR_EXPOSED"
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contracts_version",
        "blueprint",
        "shared_qrt_28",
        "topic_adapter_version"
      ],
      "properties": {
        "contracts_version": {
          "const": "1.1.0"
