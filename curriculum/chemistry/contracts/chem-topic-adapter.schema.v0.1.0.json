{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:g9v41:nsejs:chemistry:topic-adapter:0.1.0",
  "title": "NSEJS Chemistry Topic Adapter — Stage 1 Candidate Schema",
  "description": "Structure only; no schema alone verifies Chemistry truth, D3/D4 level, three truly distinct operations, or academic admission. See cross-record validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "adapter_id",
    "version",
    "subject",
    "unit_id",
    "blueprint_ref",
    "syllabus_ref",
    "status",
    "subtopics",
    "change_log"
  ],
  "properties": {
    "schema": {
      "const": "g9v41-chem-topic-adapter/v1"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^CHEM-C(0[1-9]|1[0-4])(-[A-Z0-9-]+)?$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "subject": {
      "const": "CHEMISTRY"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^C(0[1-9]|1[0-4])$"
    },
    "blueprint_ref": {
      "const": "CHEM-QRT-BLUEPRINT@0.1.0"
    },
    "syllabus_ref": {
      "const": "chemistry-syllabus.v1.json@0.1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "CANDIDATE",
        "ACADEMIC_HOLD",
        "QUALIFIED"
      ]
    },
    "canonical_truth_status": {
      "type": "string",
      "enum": [
        "PLANNED",
        "DRAFT",
        "ACADEMIC_REVIEW_PENDING",
        "QUALIFIED"
      ]
    },
    "subtopics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subtopic_id",
          "title",
          "scope",
          "canonical_truth_status",
          "canonical_concept_refs",
          "qrt_instances",
          "status"
        ],
        "properties": {
          "subtopic_id": {
            "type": "string",
            "pattern": "^CHEM-C(0[1-9]|1[0-4])\\.[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "enum": [
              "CORE_CANDIDATE",
              "FOUNDATION_RECONCILE",
              "SCOPE_REVIEW",
              "EXTENSION",
              "ENRICHMENT"
            ]
          },
          "canonical_truth_status": {
            "type": "string",
            "enum": [
              "PLANNED",
              "DRAFT",
              "ACADEMIC_REVIEW_PENDING",
              "QUALIFIED"
            ]
          },
          "canonical_concept_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "qrt_instances": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "instance_id",
                "template_ref",
                "primary_operation",
                "band",
                "canonical_concept_refs",
                "slots",
                "student_task",
                "wrong_idea",
                "replacement_rule",
                "visual_job",
                "independent_check",
                "status"
              ],
              "properties": {
                "instance_id": {
                  "type": "string",
                  "pattern": "^[A-Z0-9][A-Z0-9.-]+$"
                },
                "template_ref": {
                  "type": "string",
                  "pattern": "^QRT-(RETRIEVE|EXPLAIN|APPLY|MODEL|REPRESENT|SYNTHESIZE|JUSTIFY)-D[1-4]$"
                },
                "primary_operation": {
                  "type": "string",
                  "enum": [
                    "RETRIEVE",
                    "EXPLAIN",
                    "APPLY",
                    "MODEL",
                    "REPRESENT",
                    "SYNTHESIZE",
                    "JUSTIFY"
                  ]
                },
                "band": {
                  "type": "string",
                  "enum": [
                    "D1",
                    "D2",
                    "D3",
                    "D4"
                  ]
                },
                "canonical_concept_refs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "slots": {
                  "type": "object",
                  "required": [
                    "X",
                    "Y",
                    "Z",
                    "W"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "X": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Y": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Z": {
                      "type": "string",
                      "minLength": 1
                    },
                    "W": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "student_task": {
                  "type": "string",
                  "minLength": 1
                },
                "wrong_idea": {
                  "type": "string",
                  "minLength": 1
                },
                "replacement_rule": {
                  "type": "string",
                  "minLength": 1
                },
                "visual_job": {
                  "type": "string",
                  "minLength": 1
                },
                "independent_check": {
                  "type": "string",
                  "minLength": 1
                },
                "source_bindings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "ref",
                      "role",
                      "review_status"
                    ],
                    "properties": {
                      "ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "ACADEMIC_SOURCE",
                          "EXAM_CANDIDATE",
                          "AUTHORED_PRACTICE"
                        ]
                      },
                      "review_status": {
                        "type": "string",
                        "enum": [
                          "HOLD",
                          "CANDIDATE",
                          "VERIFIED_INDEPENDENTLY"
                        ]
                      }
                    }
                  }
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "CANDIDATE",
                    "REVIEW_PENDING",
                    "REVIEWED_TECHNICAL",
                    "ACADEMIC_HOLD",
                    "QUALIFIED"
                  ]
                }
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "CANDIDATE",
              "ACADEMIC_HOLD",
              "QUALIFIED"
            ]
          },
          "academic_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "missing_prerequisite_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "classification",
          "review_status"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "CBSE_SCOPE",
              "AUTHOR_RESEARCH",
              "EXAM_SOURCE",
              "AUTHORED_TASK"
            ]
          },
          "review_status": {
            "type": "string",
            "enum": [
              "HOLD",
              "CANDIDATE",
              "REVIEWED"
            ]
          }
        }
      }
    },
    "change_log": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "kind",
          "reason"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "INITIAL",
              "APPEND",
              "AMEND",
              "MIGRATION"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "affected_subtopic_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "x-semantic-checks": [
    "Every subtopic_id exists once in curriculum/chemistry/syllabus/chemistry-syllabus.v1.json under the specified unit_id",
    "At least three different primary_operation values per teachable subtopic; repeating MODEL-D3 and MODEL-D4 counts as one operation",
    "Each template_ref equals QRT-{primary_operation}-{band}",
    "D3/D4 template refs must resolve to a Chemistry blueprint cell; D1/D2 use canonical QRT template directly",
    "Every claimed scientific warrant must be bound to an actual canonical truth record; planned/unresolved refs keep academic_status HOLD",
    "All five difficulty factors 0..2 with evidence are required for a real candidate D3/D4 task; avoid score by template name",
    "Changing content revisions must not silently overwrite persisted first-attempt evidence",
    "Original exam question identities and figures require separate custody; schema cannot grant release",
    "An append must not delete existing subtopic IDs; an amend must declare an affected ID and new version",
    "Cross-agent references require version-pinned concept IDs, not duplicated scientific texts"
  ]
}
